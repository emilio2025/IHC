---
// Envoltura del componente Modal de Flowbite.
interface Props { id: string; max?: string; borde?: string }
const { id, max = 'max-w-lg', borde = 'border-default' } = Astro.props;
---
<div id={id} tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class={`relative p-4 w-full ${max} max-h-full`}>
    <div class={`relative bg-neutral-primary-soft border ${borde} rounded-base shadow-sm p-5 md:p-7`}>
      <slot />
    </div>
  </div>
</div>
