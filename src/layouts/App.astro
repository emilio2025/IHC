---
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
interface Props { title: string; active: string }
const { title, active } = Astro.props;
---
<Base title={`${title} · Radio Sol Andino`}>
  <div class="max-w-[1440px] mx-auto p-4 md:p-6 space-y-4">
    <Navbar active={active} />
    <slot />
    <footer class="flex flex-wrap items-center justify-between gap-3 text-xs text-body-subtle pt-2">
      <span>G1 NOOBMASTER · Módulo {active} · Astro + Tailwind CSS 4 + Flowbite 4 · modo DEMO (respuestas simuladas)</span>
      <slot name="pie" />
    </footer>
  </div>
  <slot name="fuera" />
  <div id="toasts" class="fixed bottom-5 right-5 z-[60] flex flex-col gap-3 w-[min(92vw,380px)]" aria-live="polite"></div>
</Base>
