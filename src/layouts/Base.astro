---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Manrope:wght@500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-neutral-primary text-body font-sans antialiased min-h-screen">
    <slot />
  </body>
</html>
