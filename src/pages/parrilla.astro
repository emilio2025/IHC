---
import App from '../layouts/App.astro';
import Spinner from '../components/Spinner.astro';
import Modal from '../components/Modal.astro';
import { DIAS } from '../data/mock';
const card = 'bg-neutral-primary-soft border border-default rounded-base shadow-xs p-5';
const label = 'font-mono text-[11px] tracking-[.14em] text-brand uppercase';
const btnSec = 'inline-flex items-center text-heading bg-neutral-tertiary border border-default hover:bg-neutral-tertiary-medium focus:ring-4 focus:ring-brand-medium font-medium rounded-base text-sm px-4 py-2.5 focus:outline-none';
const btnPri = 'press inline-flex items-center text-gray-950 bg-brand hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium font-bold rounded-base text-sm px-4 py-2.5 focus:outline-none';
const inp = 'block w-full px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand';
const star = 'inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-brand-soft text-fg-brand border border-brand/40';
---
<App title="Parrilla" active="Parrilla">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
  <section class={`${card} lg:col-span-8`}>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><p class={label}>Parrilla de programación</p><h1 class="font-heading font-bold text-heading text-2xl mt-1">Semana del 19 al 25 de octubre</h1><p class="text-sm mt-1"><span id="n-prog">6</span> programas hoy · <span id="n-sin">1</span> sin conductor</p></div>
      <button id="btn-nuevo" type="button" class={btnPri} data-niveles="intermedio avanzado">＋ Nuevo programa</button>
    </div>
    <ul id="dias" class="flex flex-wrap gap-1 mt-4 text-sm font-medium bg-neutral-tertiary border border-default rounded-base p-1 w-fit">
      {DIAS.map((d, i) => <li><button type="button" data-d={i} class={`dia px-3 py-1.5 rounded-base ${i === 0 ? 'bg-brand text-gray-950 font-bold' : 'text-body hover:text-heading'}`}>{d}</button></li>)}
    </ul>
    <div class="relative overflow-x-auto mt-4 border border-default rounded-base">
      <table class="w-full text-sm text-left text-body">
        <thead class="text-xs uppercase bg-neutral-tertiary border-b border-default font-mono tracking-wider"><tr><th class="px-4 py-3">Hora</th><th class="px-4 py-3">Programa</th><th class="px-4 py-3">Conductor</th><th class="px-4 py-3">Tipo</th><th class="px-4 py-3 text-end" data-niveles="intermedio avanzado">Acción</th></tr></thead>
        <tbody id="prog"></tbody>
      </table>
    </div>
  </section>
  <div class="lg:col-span-4 space-y-4">
    <section class={card}>
      <p class={`${label} mb-3`}>Resumen del día</p>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between"><dt>Horas en vivo</dt><dd id="r-vivo" class="font-mono text-heading">9 h</dd></div>
        <div class="flex justify-between"><dt>Horas con AutoDJ</dt><dd id="r-auto" class="font-mono text-heading">15 h</dd></div>
        <div class="flex justify-between"><dt>Tandas comerciales</dt><dd class="font-mono text-heading">18</dd></div>
        <div class="flex justify-between"><dt>Programas sin conductor</dt><dd id="r-sin" class="font-mono text-fg-warning">1</dd></div>
      </dl>
    </section>
    <section id="aviso-sin" class={`${card} border-amber/50`}>
      <p class="font-mono text-[11px] tracking-[.14em] text-fg-warning uppercase">Atención</p>
      <p class="font-semibold text-heading mt-1">«Tarde deportiva» no tiene conductor</p>
      <p class="text-sm mt-1">Si nadie lo toma, sonará el AutoDJ de 14:00 a 16:00.</p>
      <button id="btn-asignar" type="button" class="mt-3 inline-flex items-center text-fg-warning bg-warning-soft border border-amber/50 hover:bg-amber/20 font-medium rounded-base text-sm px-4 py-2"><span class="spin hidden"><Spinner /></span><span class="txt">Asignar conductor</span></button>
    </section>
    <section class={card} data-niveles="intermedio avanzado">
      <label class="flex items-center justify-between cursor-pointer gap-3">
        <span class="text-sm text-heading">Repetir esta parrilla cada semana</span>
        <input id="repetir" type="checkbox" class="sr-only peer" checked />
        <div class="relative w-9 h-5 bg-neutral-quaternary peer-focus:ring-4 peer-focus:ring-brand-medium rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand shrink-0"></div>
      </label>
      <p class="text-xs mt-2">Los cambios de esta semana se copian a la siguiente.</p>
    </section>
  </div>
</div>

<div slot="fuera">
<!-- Nuevo programa con valores por defecto inteligentes (Actividad 9) y control de cruces -->
<Modal id="modal-nuevo" max="max-w-2xl" borde="border-brand/40">
  <p class={label}>Nuevo programa · valores sugeridos</p>
  <h3 class="font-heading font-semibold text-heading text-2xl mt-1">Programar un espacio</h3>
  <div class="mt-3 p-3 rounded-base bg-aqua/10 border border-aqua/40 text-sm text-heading">Los campos con <span class={star}>★</span> ya vienen llenos con lo que el sistema recuerda. Cambia solo lo necesario.</div>
  <div class="grid grid-cols-1 sm:grid-cols-6 gap-4 mt-4">
    <div class="sm:col-span-6"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-nombre">Nombre del programa</label><input id="f-nombre" class={inp} placeholder="Ej.: Saludos y dedicatorias" /></div>
    <div class="sm:col-span-2"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-fecha">Fecha <span class={star}>★ hoy</span></label><input id="f-fecha" type="date" class={inp} /></div>
    <div class="sm:col-span-2"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-inicio">Inicio <span class={star}>★ franja libre</span></label><input id="f-inicio" type="time" class={inp} /></div>
    <div class="sm:col-span-2"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-dur">Duración <span class={star}>★ la última</span></label>
      <select id="f-dur" class={inp}><option value="30">30 min</option><option value="60">60 min</option><option value="90">90 min</option><option value="120">120 min</option></select></div>
    <div class="sm:col-span-3 relative"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-cond">Conductor <span class={star}>★ último usado</span></label>
      <input id="f-cond" autocomplete="off" class={inp} />
      <ul id="f-sug" class="hidden absolute z-10 mt-1 w-full bg-neutral-primary-medium border border-brand/40 rounded-base shadow-lg p-1"></ul></div>
    <div class="sm:col-span-3"><label class="flex items-center gap-2 mb-2 text-sm font-medium text-heading" for="f-tipo">Tipo <span class={star}>★ recordado</span></label>
      <select id="f-tipo" class={inp}><option>En vivo</option><option>Grabado</option><option>AutoDJ</option></select></div>
  </div>
  <!-- Alerta de cruce (Flowbite: alert) -->
  <div id="cruce" class="hidden mt-4 p-4 text-sm rounded-base bg-danger-soft border border-danger-subtle text-fg-danger" role="alert">
    <b class="text-heading">Se cruza con «<span id="cruce-con"></span>».</b> <span id="cruce-sug"></span>
    <button id="btn-mover" type="button" class="ms-2 font-semibold text-brand underline">Mover a la siguiente franja libre</button>
  </div>
  <p id="f-error" class="hidden mt-3 text-sm text-fg-danger font-semibold">Escribe el nombre del programa.</p>
  <div class="flex flex-wrap justify-between gap-3 mt-6">
    <button data-cerrar="modal-nuevo" type="button" class={btnSec}>Cancelar</button>
    <button id="btn-guardar" type="button" class={btnPri}><span class="spin hidden"><Spinner /></span><span class="txt">Guardar programa</span></button>
  </div>
</Modal>
</div>
<script src="../scripts/parrilla.ts"></script>
</App>
