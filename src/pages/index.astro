---
import App from '../layouts/App.astro';
import Spinner from '../components/Spinner.astro';
import { SONANDO, SIGUIENTE, COLA, PAUTA, PARRILLA, INSERTABLES } from '../data/mock';
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const tipoBadge: Record<string, string> = {
  'Canción': 'bg-success-soft text-fg-success border-brand/40',
  'Pauta': 'bg-warning-soft text-fg-warning border-amber/40',
  'Cuña': 'bg-warning-soft text-fg-warning border-amber/40',
  'Jingle': 'bg-aqua/10 text-aqua border-aqua/40',
};
const card = 'bg-neutral-primary-soft border border-default rounded-base shadow-xs p-5';
const label = 'font-mono text-[11px] tracking-[.14em] text-brand uppercase';
---
<App title="Cabina" active="Cabina">

  <!-- Estado de error (Flowbite: alert). Visible solo cuando se pierde la conexión con AzuraCast. -->
  <div id="alerta-conexion" class="hidden flex items-center gap-3 p-4 text-sm text-fg-danger rounded-base bg-danger-soft border border-danger-subtle" role="alert">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
    <div class="flex-1"><b class="text-heading">Conexión perdida con el servidor AzuraCast.</b> La radio sigue al aire con el AutoDJ. <span id="reintento-txt">Reintentando en 5 s…</span></div>
    <button id="btn-reintentar" type="button" class="text-white bg-danger hover:bg-danger-strong font-medium rounded-base text-xs px-3 py-2">Reintentar ahora</button>
  </div>

  <!-- Alerta de silencio al aire (Actividad 9: resultado de silenciar) -->
  <div id="alerta-silencio" class="hidden flex flex-wrap items-center gap-4 p-4 rounded-base bg-danger-soft border border-onair glow-onair" role="alert">
    <span class="w-3 h-3 rounded-full bg-onair pulse-dot"></span>
    <div class="flex-1 min-w-60"><p class="font-heading font-bold text-heading text-lg">La emisora está en silencio</p><p class="text-sm text-fg-danger">Sin señal hace <b id="silencio-t" class="font-mono tabular">0 s</b>. A los 15 s se avisa al director por celular.</p></div>
    <button id="btn-reanudar" type="button" class="press inline-flex items-center text-gray-950 bg-brand hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium font-bold rounded-base text-sm px-5 py-3 focus:outline-none">Reanudar AutoDJ</button>
  </div>

  <!-- Estado de carga (Flowbite: skeleton) -->
  <div id="skeleton" class="grid grid-cols-1 lg:grid-cols-12 gap-4" role="status" aria-label="Cargando la cabina">
    {[3, 6, 3, 9, 3].map((c) => (
      <div class={`animate-pulse ${card} ${c === 9 ? 'lg:col-span-9' : c === 6 ? 'lg:col-span-6' : 'lg:col-span-3'}`}>
        <div class="h-2.5 bg-neutral-tertiary-medium rounded-full w-24 mb-4"></div>
        <div class="h-6 bg-neutral-tertiary-medium rounded-full w-48 mb-3"></div>
        <div class="h-2 bg-neutral-tertiary-medium rounded-full mb-2.5"></div>
        <div class="h-2 bg-neutral-tertiary-medium rounded-full w-3/4"></div>
      </div>
    ))}
    <span class="sr-only">Cargando…</span>
  </div>

  <main id="cabina" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-4">
    <!-- AL AIRE -->
    <section class={`${card} lg:col-span-3 flex flex-col items-center justify-center text-center gap-3`}>
      <p class="font-mono text-[11px] tracking-[.14em] text-fg-danger uppercase" id="aire-label">Estás al aire</p>
      <div id="aire-circulo" class="grid place-items-center w-40 h-40 rounded-full bg-onair/90 glow-onair">
        <div><p class="font-heading font-bold text-white text-2xl" id="aire-titulo">AL AIRE</p><p class="font-mono text-white tabular" id="aire-tiempo">00:24:13</p></div>
      </div>
      <p class="text-xs">Programa «Mañanas andinas» · 06:00 – 11:00</p>
    </section>

    <!-- SONANDO AHORA -->
    <section class={`${card} lg:col-span-6`}>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class={label}>Sonando ahora</p>
          <h1 class="font-heading font-bold text-heading text-3xl mt-1" id="np-titulo">{SONANDO.titulo}</h1>
          <p class="text-sm mt-1" id="np-meta">{SONANDO.artista} · {SONANDO.genero} · Lista «{SONANDO.lista}»</p>
        </div>
        <div class="text-end">
          <p class="font-mono text-[11px] tracking-[.14em] uppercase">Restan</p>
          <p class="font-mono font-bold text-heading text-5xl tabular" id="np-restan">{fmt(SONANDO.duracion)}</p>
          <p class="text-xs mt-1">Luego: <span id="np-luego">«{SIGUIENTE.titulo}»</span></p>
        </div>
      </div>
      <!-- Flowbite: progress -->
      <div class="w-full bg-neutral-tertiary-medium rounded-full h-2 mt-5"><div id="np-barra" class="bg-brand h-2 rounded-full" style="width:0%"></div></div>
      <div class="flex justify-between font-mono text-xs mt-1 tabular"><span id="np-trans">0:00</span><span id="np-dur">{fmt(SONANDO.duracion)}</span></div>
      <div class="flex flex-wrap items-center gap-3 mt-4">
        <button id="btn-siguiente" type="button" class="press inline-flex items-center text-heading bg-neutral-tertiary border border-default hover:bg-neutral-tertiary-medium focus:ring-4 focus:ring-brand-medium font-medium rounded-base text-sm px-4 py-2.5 focus:outline-none" data-niveles="intermedio avanzado">
          <span class="spin hidden"><Spinner /></span><span class="txt">Siguiente canción</span>
        </button>
        <span class="text-xs text-body-subtle">Pausar está protegido: pide confirmación.</span>
      </div>
    </section>

    <!-- MICRÓFONO: bucle perceptual (Actividad 10) -->
    <section class={`${card} lg:col-span-3 flex flex-col gap-4`}>
      <div class="flex items-center justify-between"><p class={label}>Micrófono</p>
        <span id="mic-estado" class="bg-neutral-tertiary text-body text-xs font-medium px-2 py-0.5 rounded-full border border-default">Cerrado</span></div>
      <button id="btn-hablar" type="button" data-estado="reposo" aria-pressed="false"
        class="press relative overflow-hidden w-full inline-flex items-center justify-center gap-2 text-white bg-danger hover:bg-danger-strong focus:ring-4 focus:ring-danger-medium font-heading font-bold rounded-base text-base px-5 py-4 focus:outline-none">
        <span class="spin hidden"><Spinner class="w-5 h-5" /></span>
        <span class="dot hidden w-2.5 h-2.5 rounded-full bg-white pulse-dot"></span>
        <svg class="ico w-5 h-5" viewBox="0 0 24 24" fill="none"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="txt">Hablar al aire</span>
        <span class="micro absolute left-0 bottom-0 h-[3px] bg-white/90 transition-[width] duration-200" style="width:0%"></span>
      </button>
      <p class="text-xs -mt-2">Atajo: barra espaciadora</p>
      <div>
        <p class="font-mono text-[11px] tracking-[.14em] uppercase mb-2">Nivel de voz (L / R)</p>
        <div class="space-y-1.5" id="vu"></div>
        <div class="flex items-center justify-between mt-2">
          <span class="font-mono text-xs text-heading tabular" data-niveles="avanzado" id="vu-db">-∞ dB</span>
          <span id="ducking" class="hidden bg-warning-soft text-fg-warning border border-amber/40 text-xs font-medium px-2 py-0.5 rounded-full">Música −14 dB</span>
        </div>
      </div>
    </section>

    <!-- PAUTA: cartuchos (Actividad 10, acción 2) -->
    <section class={`${card} lg:col-span-9`}>
      <div class="flex items-center justify-between mb-1"><p class={label}>Pauta · tanda de las 10:45</p>
        <span class="bg-warning-soft text-fg-warning border border-amber/40 text-xs font-medium px-2.5 py-0.5 rounded-full">Próxima tanda en 02:41</span></div>
      <p class="text-xs mb-4">Un toque lanza la pieza al aire (teclas F1–F6). Mientras suena, el cartucho se bloquea para no repetirla.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3">
        {PAUTA.map((c) => (
          <button type="button" class="cart press relative overflow-hidden text-start bg-neutral-tertiary border border-default hover:border-amber/60 rounded-base p-3 focus:ring-4 focus:ring-brand-medium focus:outline-none" data-id={c.id} data-nombre={c.nombre} data-dur={c.duracion} data-tecla={c.tecla} data-estado="reposo">
            <span class="block w-7 h-[3px] rounded-full bg-amber mb-2"></span>
            <span class="block text-sm font-semibold text-heading leading-snug min-h-10">{c.nombre}</span>
            <span class="flex items-center justify-between mt-2 font-mono text-[11px]">
              <span class="tipo font-bold text-amber">{c.tipo}</span>
              <span class="dur font-bold text-heading inline-flex items-center"><span class="spin hidden"><Spinner class="w-3 h-3 me-1" /></span><span class="durtxt">▶ {fmt(c.duracion)}</span></span>
            </span>
            <span class="font-mono text-[10px] text-body-subtle absolute top-2 right-2">{c.tecla}</span>
            <span class="micro absolute left-0 bottom-0 h-1 bg-amber" style="width:0%"></span>
          </button>
        ))}
      </div>
    </section>

    <!-- SEGURIDAD -->
    <section class={`${card} lg:col-span-3 flex flex-col gap-3`}>
      <p class={label}>Lo que viene</p>
      <div class="flex items-center justify-between"><span class="font-heading font-semibold text-heading">Noticiero regional</span><span class="font-mono text-heading tabular">11:00</span></div>
      <hr class="border-default" />
      <div data-niveles="avanzado" class="text-xs space-y-1">
        <p class={label}>Servidor · AzuraCast</p>
        <p class="flex justify-between"><span>Stream</span><span class="font-mono text-heading">Icecast · 128 kbps</span></p>
        <p class="flex justify-between"><span>Latencia</span><span class="font-mono text-heading">1,4 s</span></p>
      </div>
      <div class="mt-auto flex items-center justify-between gap-2">
        <span class="text-sm">Silenciar la emisora</span>
        <button id="btn-abrir-silenciar" type="button" class="inline-flex items-center gap-1.5 text-fg-danger bg-danger-soft border border-danger-subtle hover:bg-danger-medium font-medium rounded-base text-sm px-3 py-2 focus:ring-4 focus:ring-danger-medium focus:outline-none">⏻ Silenciar</button>
      </div>
    </section>

    <!-- COLA DEL AUTODJ -->
    <section class={`${card} lg:col-span-4`} data-niveles="intermedio avanzado">
      <div class="flex items-center justify-between mb-3"><p class={label}>Cola del AutoDJ</p>
        <button id="btn-abrir-insertar" type="button" class="inline-flex items-center gap-1 text-brand hover:underline text-sm font-semibold">＋ Insertar</button></div>
      <ul id="cola" class="divide-y divide-default">
        {COLA.map((i) => (
          <li class="flex items-center gap-3 py-2"><span class="font-mono text-xs text-brand tabular">{i.hora}</span><span class="flex-1 text-sm text-heading truncate">{i.titulo}</span>
            <span class={`text-xs font-medium px-2 py-0.5 rounded-full border ${tipoBadge[i.tipo]}`}>{i.tipo}</span></li>
        ))}
      </ul>
      <p id="cola-vacia" class="hidden text-sm text-center py-6">La cola está vacía. El AutoDJ elegirá música de la lista activa. <button class="text-brand font-semibold">Insertar algo</button></p>
    </section>

    <!-- REGISTRO DE EVENTOS (Flowbite: timeline) -->
    <section class={`${card} lg:col-span-5`} data-niveles="intermedio avanzado">
      <p class={`${label} mb-3`}>Registro de eventos</p>
      <div class="max-h-52 overflow-y-auto ps-2"><ol id="eventos" class="relative border-s border-default space-y-2">
        <li class="ms-4"><span class="absolute w-2.5 h-2.5 bg-brand rounded-full -start-[5.5px] mt-1.5"></span><span class="font-mono text-xs text-brand me-2">10:42:18</span><span class="text-sm text-heading">Valicha al aire (Deck A)</span></li>
        <li class="ms-4"><span class="absolute w-2.5 h-2.5 bg-neutral-quaternary rounded-full -start-[5.5px] mt-1.5"></span><span class="font-mono text-xs me-2">10:40:12</span><span class="text-sm">Cuña «Pollería Don Lucho» emitida</span></li>
      </ol></div>
    </section>

    <!-- PARRILLA DE HOY -->
    <section class={`${card} lg:col-span-3`}>
      <p class={`${label} mb-3`}>Hoy en la parrilla</p>
      <ul class="space-y-2.5">
        {PARRILLA.map((p) => (
          <li class="flex items-center gap-2 text-sm"><span class="font-mono text-heading tabular">{p.hora}</span><span class="flex-1 truncate">{p.programa}</span>
            <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full border ${p.estado === 'Al aire' ? 'bg-danger-soft text-fg-danger border-danger-subtle' : p.estado === 'Programado' ? 'bg-success-soft text-fg-success border-brand/40' : 'bg-warning-soft text-fg-warning border-amber/40'}`}>{p.estado}</span></li>
        ))}
      </ul>
    </section>
  </main>

  <span slot="pie" class="flex gap-2">
    <button id="btn-sim-error" class="text-body hover:text-heading underline">Simular corte de conexión</button>
    <button id="btn-sim-vacio" class="text-body hover:text-heading underline" data-niveles="intermedio avanzado">Vaciar cola</button>
  </span>
<div slot="fuera">

<!-- ===== MODAL: Silenciar emisora (Actividad 9 · prevención activa) — Flowbite modal ===== -->
<div id="modal-silenciar" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-lg max-h-full">
    <div class="relative bg-neutral-primary-soft border border-onair/50 rounded-base shadow-sm p-5 md:p-7">
      <p class="font-mono text-[11px] tracking-[.14em] text-fg-danger uppercase">Acción crítica al aire</p>
      <h3 class="font-heading font-semibold text-heading text-2xl mt-1">Silenciar Radio Sol Andino 98.7 FM</h3>
      <p class="text-sm mt-2">La señal quedará en silencio para los <b id="sil-oyentes" class="text-heading">128</b> oyentes conectados. Úsalo solo ante una emergencia técnica o legal.</p>
      <ul class="mt-4 p-3 rounded-base bg-danger-soft border border-danger-subtle text-sm text-fg-danger space-y-1 list-disc ps-6">
        <li>Se cortan el Deck A, los micrófonos y el AutoDJ.</li>
        <li>AzuraCast registra el corte en el reporte de emisión.</li>
      </ul>
      <label for="sil-input" class="block mb-2 mt-4 text-sm font-medium text-heading">Para confirmar, escribe <span class="font-mono text-fg-danger">SILENCIAR</span>:</label>
      <input id="sil-input" type="text" autocomplete="off" spellcheck="false" class="bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 font-mono" placeholder="SILENCIAR" />
      <p id="sil-coincide" class="hidden mt-1 text-xs text-fg-success font-semibold">Coincide</p>
      <div class="flex items-center mt-4">
        <input id="sil-check" type="checkbox" class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft" />
        <label for="sil-check" class="select-none ms-2 text-sm font-medium text-heading">Avisé al director de turno (Julio Huamán)</label>
      </div>
      <p id="sil-conteo" class="hidden mt-4 text-sm text-fg-warning font-semibold"></p>
      <p id="sil-error" class="hidden mt-3 text-sm text-fg-danger font-semibold">Falta escribir SILENCIAR o marcar la casilla.</p>
      <div class="flex items-center justify-between gap-3 mt-6">
        <button data-cerrar="modal-silenciar" type="button" class="text-heading bg-neutral-tertiary border border-default hover:bg-neutral-tertiary-medium focus:ring-4 focus:ring-brand-medium font-medium rounded-base text-sm px-4 py-2.5 focus:outline-none">Cancelar</button>
        <button id="sil-confirmar" type="button" aria-disabled="true" class="press inline-flex items-center text-white bg-danger hover:bg-danger-strong focus:ring-4 focus:ring-danger-medium font-bold rounded-base text-sm px-5 py-2.5 focus:outline-none opacity-40 cursor-not-allowed">
          <span class="spin hidden"><Spinner /></span><span class="txt">Silenciar emisora</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL: Insertar en la cola (Actividad 8 · Ley de Hick) — Flowbite modal + tabs ===== -->
<div id="modal-insertar" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-xl max-h-full">
    <div class="relative bg-neutral-primary-soft border border-default rounded-base shadow-sm p-5 md:p-7">
      <div class="flex items-start justify-between">
        <div><p class={label}>Cola del AutoDJ · insertar</p><h3 class="font-heading font-semibold text-heading text-2xl mt-1">¿Qué quieres insertar?</h3></div>
        <button type="button" data-cerrar="modal-insertar" class="text-body bg-transparent hover:bg-neutral-tertiary hover:text-heading rounded-base text-sm w-9 h-9 inline-flex justify-center items-center" aria-label="Cerrar">✕</button>
      </div>
      <!-- 3 categorías en lugar de 16 opciones planas -->
      <ul id="ins-tabs" class="flex text-sm font-medium bg-neutral-tertiary border border-default rounded-base p-1 gap-1 mt-4">
        {['Canción', 'Cuña y pauta', 'Jingle e ID'].map((c, i) => (
          <li class="flex-1"><button type="button" data-cat={c} class={`ins-tab w-full px-3 py-2 rounded-base ${i === 1 ? 'bg-brand text-gray-950 font-bold' : 'text-body hover:text-heading'}`}>{c} <span class="font-mono text-[10px] opacity-70">{INSERTABLES.filter((x) => x.categoria === c).length}</span></button></li>
        ))}
      </ul>
      <div id="ins-sugerida" class="flex items-center gap-3 mt-4 p-3 rounded-base bg-warning-soft border border-amber/50">
        <div class="flex-1"><p class="text-sm font-bold text-heading">Toca ahora: Tanda comercial 10:45</p><p class="text-xs text-fg-warning">Programada en la parrilla · empieza en 3 min</p></div>
        <button type="button" class="ins-item press inline-flex items-center text-gray-950 bg-brand hover:bg-brand-strong font-bold rounded-base text-sm px-4 py-2" data-nombre="Tanda comercial 10:45"><span class="spin hidden"><Spinner /></span><span class="txt">Insertar</span></button>
      </div>
      <!-- Búsqueda predictiva -->
      <label for="ins-buscar" class="sr-only">Buscar</label>
      <div class="relative mt-4">
        <svg class="w-4 h-4 absolute start-3 top-1/2 -translate-y-1/2 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="ins-buscar" type="search" autocomplete="off" class="block w-full ps-9 pe-3 py-2.5 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand" placeholder="Busca dentro de «Cuña y pauta» (2–3 letras)" />
      </div>
      <ul id="ins-lista" class="mt-2 max-h-56 overflow-y-auto divide-y divide-default border border-default rounded-base"></ul>
      <div class="flex flex-wrap items-center gap-2 mt-3 text-xs"><span>Recientes:</span>
        <button type="button" class="ins-item bg-neutral-tertiary border border-default hover:bg-neutral-tertiary-medium text-heading rounded-full px-3 py-1" data-nombre="Cuña Pollería Don Lucho"><span class="spin hidden"><Spinner class="w-3 h-3 me-1" /></span><span class="txt">Cuña Pollería Don Lucho</span></button>
        <button type="button" class="ins-item bg-neutral-tertiary border border-default hover:bg-neutral-tertiary-medium text-heading rounded-full px-3 py-1" data-nombre="Pauta municipal"><span class="spin hidden"><Spinner class="w-3 h-3 me-1" /></span><span class="txt">Pauta municipal</span></button>
      </div>
    </div>
  </div>
</div>


<template id="tpl-insertable">
  <li><button type="button" class="ins-item w-full flex items-center gap-3 px-3 py-2.5 text-start hover:bg-neutral-tertiary"><span class="spin hidden"><Spinner /></span><span class="txt text-sm font-semibold text-heading"></span><span class="meta text-xs ms-auto"></span></button></li>
</template>
</div>
<script src="../scripts/cabina.ts"></script>
</App>
